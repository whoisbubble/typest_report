Ниже приведен исходный код подпрограммы цифровой обработки телеметрии:

```python
from typing import List

class TelemetryFilter:
    """Класс кольцевой скользящей фильтрации фазных токов ТЭД."""

    def __init__(self, window_size: int = 5) -> None:
        if window_size <= 0:
            raise ValueError("Размер окна фильтра должен быть положительным числом")
        self.window_size = window_size
        self.buffer: List[float] = []

    def process_sample(self, raw_current: float) -> float:
        """Добавление отсчета и расчет сглаженного значения тока."""
        self.buffer.append(raw_current)
        if len(self.buffer) > self.window_size:
            self.buffer.pop(0)
        return sum(self.buffer) / len(self.buffer)

    def clear(self) -> None:
        """Очистка внутреннего буфера."""
        self.buffer.clear()

if __name__ == "__main__":
    current_filter = TelemetryFilter(window_size=3)
    samples = [0.0, 420.5, 418.0, 245.0, 210.4]

    print("Результаты сглаживания:")
    for val in samples:
        filtered = current_filter.process_sample(val)
        print(f"Вход: {val:5.1f} А -> Выход: {filtered:5.1f} А")
```
