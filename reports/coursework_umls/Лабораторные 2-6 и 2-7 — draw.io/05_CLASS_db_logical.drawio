<mxfile host="app.diagrams.net" modified="2026-11-13T00:00:00.000Z" agent="Codex" version="32.6.10"><diagram name="Логическая диаграмма классов базы данных" id="05_CLASS_db_logical"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1260" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Логическая диаграмма классов базы данных" vertex="1" parent="1" style="text;html=1;strokeColor=none;whiteSpace=wrap;verticalAlign=middle;align=center;fontFamily=Times New Roman;fontSize=24;fontStyle=1;fillColor=none;spacing=2;"><mxGeometry x="260" y="20" width="1430" height="42" as="geometry" /></mxCell><mxCell id="user" value="&lt;div style='text-align:center;'&gt;&lt;b&gt;Пользователь&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #000;padding:5px 7px 2px 7px;'&gt;- идентификатор&lt;br&gt;- электронная почта&lt;br&gt;- пароль&lt;br&gt;- роль&lt;br&gt;- признак активности&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Times New Roman;fontSize=16;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;"><mxGeometry x="60" y="120" width="310" height="200" as="geometry" /></mxCell><mxCell id="client" value="&lt;div style='text-align:center;'&gt;&lt;b&gt;Клиент&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #000;padding:5px 7px 2px 7px;'&gt;- идентификатор&lt;br&gt;- наименование&lt;br&gt;- контактные данные&lt;br&gt;- дата создания&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Times New Roman;fontSize=16;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;"><mxGeometry x="60" y="520" width="310" height="178" as="geometry" /></mxCell><mxCell id="campaign" value="&lt;div style='text-align:center;'&gt;&lt;b&gt;Кампания&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #000;padding:5px 7px 2px 7px;'&gt;- идентификатор&lt;br&gt;- наименование&lt;br&gt;- бюджет&lt;br&gt;- статус&lt;br&gt;- период проведения&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Times New Roman;fontSize=16;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;"><mxGeometry x="450" y="300" width="340" height="200" as="geometry" /></mxCell><mxCell id="publication" value="&lt;div style='text-align:center;'&gt;&lt;b&gt;Публикация&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #000;padding:5px 7px 2px 7px;'&gt;- идентификатор&lt;br&gt;- площадка&lt;br&gt;- внешний идентификатор&lt;br&gt;- дата публикации&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Times New Roman;fontSize=16;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;"><mxGeometry x="900" y="100" width="340" height="178" as="geometry" /></mxCell><mxCell id="import" value="&lt;div style='text-align:center;'&gt;&lt;b&gt;Импорт&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #000;padding:5px 7px 2px 7px;'&gt;- идентификатор&lt;br&gt;- источник&lt;br&gt;- статус&lt;br&gt;- дата запуска&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Times New Roman;fontSize=16;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;"><mxGeometry x="900" y="500" width="340" height="178" as="geometry" /></mxCell><mxCell id="metric" value="&lt;div style='text-align:center;'&gt;&lt;b&gt;Метрика&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #000;padding:5px 7px 2px 7px;'&gt;- идентификатор&lt;br&gt;- просмотры&lt;br&gt;- отметки «Нравится»&lt;br&gt;- дата фиксации&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Times New Roman;fontSize=16;fillColor=#FFFFFF;strokeColo