<mxfile host="app.diagrams.net"><diagram name="Состав исполняемых компонентов системы"><mxGraphModel pageWidth="2440" pageHeight="2060"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="browser" value="«component»&lt;br&gt;Клиентский JS-пакет&lt;hr&gt;среда: браузер пользователя&lt;br&gt;требует: Web / REST через HTTPS" vertex="1" parent="1" style="shape=component;align=left;spacing=14;html=1;fontFamily=Arial;fontSize=19;fillColor=#ffffff;strokeColor=#222222;"><mxGeometry x="120" y="160" width="600" height="220" as="geometry" /></mxCell><mxCell id="gateway" value="«component»&lt;br&gt;Обратный прокси Nginx&lt;hr&gt;предоставляет: HTTPS, порт 443&lt;br&gt;маршруты / → Web, /api/* → API" vertex="1" parent="1" style="shape=component;align=left;spacing=14;html=1;fontFamily=Arial;fontSize=19;fillColor=#ffffff;strokeColor=#222222;"><mxGeometry x="920" y="160" width="600" height="220" as="geometry" /></mxCell><mxCell id="web" value="«component»&lt;br&gt;Веб-приложение Next.js&lt;hr&gt;предоставляет: Web / HTTP&lt;br&gt;страницы, ресурсы, клиентский JS" vertex="1" parent="1" style="shape=component;align=left;spacing=14;html=1;fontFamily=Arial;fontSize=19;fillColor=#ffffff;strokeColor=#222222;"><mxGeometry x="1720" y="160" width="600" height="220" as="geometry" /></mxCell><mxCell id="api" value="«component»&lt;br&gt;API NestJS&lt;hr&gt;предоставляет: REST / JSON&lt;br&gt;идентификация, доступ и сценарии&lt;br&gt;требует: PostgreSQL / SQL" vertex="1" parent="1" style="shape=component;align=left;spacing=14;html=1;fontFamily=Arial;fontSize=19;fillColor=#ffffff;strokeColor=#222222;"><mxGeometry x="920" y="680" width="600" height="260" as="geometry" /></mxCell><mxCell id="worker" value="«component»&lt;br&gt;Фоновый обработчик&lt;hr&gt;Node.js · прикладной модуль анализа&lt;br&gt;требует: PostgreSQL / SQL&lt;br&gt;ML-адаптер — будущая ВКР" vertex="1" parent="1" style="shape=component;align=left;spacing=14;html=1;fontFamily=Arial;fontSize=19;fillColor=#ffffff;strokeColor=#222222;"><mxGeometry x="1720" y="1220" width="600" height="260" as="geometry" /></mxCell><mxCell id="db" value="«component»&lt;br&gt;СУБД PostgreSQL&lt;hr&gt;предоставляет: PostgreSQL / SQL&lt;br&gt;таблицы предметной области&lt;br&gt;транзакции, ограничения, аудит" vertex="1" parent="1" style="shape=component;align=left;spacing=14;html=1;fontFamily=Arial;fontSize=19;fillColor=#ffffff;strokeColor=#222222;"><mxGeometry x="920" y="1220" width="600" height="260" as="geometry" /></mxCell><mxCell id="backup" value="«component»&lt;br&gt;Резервное копирование&lt;hr&gt;pg_dump + планировщик + SFTP&lt;br&gt;требует: SQL и доступ к архиву&lt;br&gt;отдельная служебная учётная запись" vertex="1" parent="1" style="shape=component;align=left;spacing=14;html=1;fontFamily=Arial;fontSize=19;fillColor=#ffffff;strokeColor=#222222;"><mxGeometry x="120" y="1220" width="600" height="260" as="geometry" /></mxCell><mxCell id="archive" value="«component»&lt;br&gt;Архив резервных копий&lt;hr&gt;предоставляет: SFTP / SSH&lt;br&gt;зашифрованные файлы дампов" vertex="1" parent="1" style="shape=component;align=left;spacing=14;html=1;fontFamily=Arial;fontSize=19;fillColor=#ffffff;strokeColor=#222222;"><mxGeometry x="120" y="1740" width="600" height="220" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" style="edgeStyle=none;rounded=1;endArrow=none;strokeColor=#222222;dashed=1;endArrow=open;"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="270" as="sourcePoint" /><mxPoint x="920" y="270" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" style="edgeStyle=none;rounded=1;endArrow=none;strokeColor=#222222;dashed=1;endArrow=open;"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="270" as="sourcePoint" /><mxPoint x="1720" y="270" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" edge="1" parent="1" style="edgeStyle=none;rounded=1;endArrow=none;strokeColor=#222222;dashed=1;endArrow=open;"><mxG